# 阿里云 ASR 配置（一句话识别）
# 方式1: 使用 AccessKey（推荐生产环境，自动刷新 Token）
ALIYUN_ACCESS_KEY_ID=LTAI***************
ALIYUN_ACCESS_KEY_SECRET=******************************
ALIYUN_ASR_APPKEY=tt43P2u****

# 方式2: 直接使用 Token（快速测试，24小时有效）
# ALIYUN_NLS_TOKEN=你的Token
# ALIYUN_ASR_APPKEY=tt43P2u****

# 云端 LLM API 配置（DeepSeek/OpenAI/兼容服务）
# DeepSeek API
API_KEY=sk-***************************
API_URL=https://api.deepseek.com/chat/completions

# OpenAI API
# API_KEY=sk-***************************
# API_URL=https://api.openai.com/v1/chat/completions

# 本地兼容服务
# API_KEY=your-key
# API_URL=http://localhost:8000/v1/chat/completions

# 注意:
# 1. 复制此文件为 .env 并填入真实的密钥
# 2. 环境变量优先级高于 .env 文件
